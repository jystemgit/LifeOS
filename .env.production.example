# Copy to .env.production, chmod 600, and replace every placeholder.
# Never commit .env.production. This file contains examples, not real secrets.
LIFEOS_DOMAIN=lifeos.example.com
LIFEOS_IMAGE_TAG=local
OWNER_EMAIL=owner@example.com
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
# Use openssl rand -hex 32 (hex is safe in a connection URL).
POSTGRES_PASSWORD=replace-with-generated-hex-password
# Separate bootstrap administrator; never passed to the application container.
POSTGRES_ADMIN_PASSWORD=replace-with-different-generated-hex-password
# Use openssl rand -base64 48. Preserve this across releases; it also protects OAuth tokens.
BETTER_AUTH_SECRET=replace-with-generated-auth-secret
# Compose derives DATABASE_URL and BETTER_AUTH_URL from the values above.

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT_ID=common
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
TASK_PUSH_ENABLED=false
TASK_PUSH_VAPID_PUBLIC_KEY=
TASK_PUSH_VAPID_PRIVATE_KEY=
TASK_PUSH_VAPID_SUBJECT=
