# Copy to .env and replace every placeholder before starting the application.
# Never use these local settings in production.
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
POSTGRES_PASSWORD=replace-with-a-unique-local-password
DATABASE_URL=postgresql://lifeos:replace-with-a-unique-local-password@localhost:5432/lifeos?schema=public
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
OWNER_EMAIL=hello@augustovalmont.com

# Optional limited Microsoft To Do connector; see docs/task-management.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT_ID=common

# Optional dedicated task calendar; see docs/task-management.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Optional background task reminders; native tasks/in-app reminders never need these.
# Generate once with npm run reminders:keys; keep the private key in your secret store.
# Run npm run reminders:deliver every minute from a scheduled server worker.
TASK_PUSH_ENABLED=false
TASK_PUSH_VAPID_PUBLIC_KEY=
TASK_PUSH_VAPID_PRIVATE_KEY=
TASK_PUSH_VAPID_SUBJECT=
