{
  "name": "life-os",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prestart": "node scripts/validate-production-env.mjs",
    "check:production": "node scripts/validate-production-env.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:production": "node scripts/production-smoke.mjs",
    "prebuild": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:backup": "tsx scripts/database-backup.ts",
    "reminders:deliver": "tsx scripts/deliver-task-reminders.ts",
    "reminders:keys": "web-push generate-vapid-keys",
    "db:seed": "prisma generate && prisma db seed",
    "db:setup": "npm run db:deploy && npm run db:seed"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.14",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "^1.7.14",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "auth": "^1.7.14",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
